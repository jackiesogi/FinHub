# --- [PYTHON CORE] ---
.venv/
venv/
__pycache__/
*.pyc
.env

# --- [SECURITY & CONFIG] ---
# config.py is tracked: it holds no secrets, only loopback defaults and the
# names of the env vars that carry them. Secrets live in .env, above.
*.db
*.sqlite

# --- [IDE & SYSTEM] ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- [PROJECT ARTIFACTS & LOGS] ---
# Captured stdout/stderr of the runs FinHub started.
run_logs/
# Per-run copies of strategy source, written when a run starts. Build
# artifacts of a run, not source: the record lives in the database.
run_strategies/
archive/
*.log
.pytest_cache/
