# Copy to .env and edit. Nothing here is required to start FinHub; the
# defaults are all loopback and the CJTrade path is the usual checkout.

# Signs session tokens. Without it FinHub generates a random one per process,
# which is safe but logs everyone out on every restart. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=

# Where CJTrade lives, so FinHub can start a run.
CJTRADE_REPO=~/Downloads/gitrepo/CJTrade

# The engine's read-only status API. Host is loopback and stays loopback:
# the engine serves account data with no authentication and no CORS header.
ENGINE_STATUS_HOST=127.0.0.1
ENGINE_STATUS_PORT=8898

# The ArenaX broker-side server. 8802 is the backtest instance.
ARENAX_HOST=127.0.0.1
ARENAX_PORT=8802
ARENAX_API_KEY=testkey123

# Blank uses a SQLite file next to the code.
DATABASE_URL=
